# CIVENTRAL - Local Environment Variables (example)
# Copy this file to .env and fill in real values. Never commit .env.

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Local MySQL (XAMPP default: root / no password)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=civentral_urbanplanning
DB_USER=root
DB_PASSWORD=

# reCAPTCHA Configuration
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Civentral"

# API proxy target - employee/citizen API calls (login, OTP, permissions, etc.)
# forward here. Left as production since that's where your credentials are valid.
EXPO_PUBLIC_API_BASE_URL=https://civentral.tech/api/employee

# Gemini API (AI Planning Assistant module) - server-side only, never expose to frontend.
GEMINI_API_KEY=
